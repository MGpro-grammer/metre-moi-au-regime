<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="1200.0" prefWidth="2000.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="be.esi.prj.controller.DashboardPhotoController">
    <stylesheets>
        <URL value="@../style/dashboard.css" />
    </stylesheets>

    <Pane prefHeight="600.0" prefWidth="1000.0" styleClass="container-dashboard">
        <Pane layoutX="100.0" layoutY="50.0" prefHeight="500.0" prefWidth="800.0" styleClass="interface-dashboard">
            <Pane layoutY="445.0" prefHeight="56.0" prefWidth="800.0" styleClass="interface-dashboard-ariane">
                <Pane fx:id="home" prefHeight="56.0" prefWidth="100.0">
                    <ImageView fitHeight="30.0" fitWidth="30.0" layoutX="35.0" layoutY="13.0">
                        <Image url="@../images/house-white.png" />
                    </ImageView>
                </Pane>
                <Pane fx:id="user" layoutX="100.0" prefHeight="56.0" prefWidth="100.0">
                    <ImageView fitHeight="30.0" fitWidth="30.0" layoutX="35.0" layoutY="13.0">
                        <Image url="@../images/user-white.png" />
                    </ImageView>
                </Pane>
                <Pane fx:id="photo" layoutX="200.0" prefHeight="56.0" prefWidth="100.0">
                    <ImageView fitHeight="30.0" fitWidth="30.0" layoutX="35.0" layoutY="13.0">
                        <Image url="@../images/file-image.png" />
                    </ImageView>
                </Pane>
                <Pane fx:id="search" layoutX="300.0" prefHeight="56.0" prefWidth="100.0">
                    <ImageView fitHeight="30.0" fitWidth="30.0" layoutX="35.0" layoutY="13.0">
                        <Image url="@../images/search.png" />
                    </ImageView>
                </Pane>
                <Pane fx:id="activity" layoutX="400.0" prefHeight="56.0" prefWidth="100.0">
                    <ImageView fitHeight="30.0" fitWidth="30.0" layoutX="35.0" layoutY="13.0">
                        <Image url="@../images/activity.png" />
                    </ImageView>
                </Pane>
                <Pane fx:id="product" layoutX="500.0" prefHeight="56.0" prefWidth="100.0">
                    <ImageView fitHeight="30.0" fitWidth="30.0" layoutX="35.0" layoutY="13.0">
                        <Image url="@../images/package-search.png" />
                    </ImageView>
                </Pane>
                <Pane fx:id="info" layoutX="600.0" prefHeight="56.0" prefWidth="100.0">
                    <ImageView fitHeight="30.0" fitWidth="30.0" layoutX="35.0" layoutY="13.0">
                        <Image url="@../images/info.png"/>
                    </ImageView>
                </Pane>
            </Pane>
            <Pane prefHeight="447.0" prefWidth="800.0">
                <Pane fx:id="photoZone" layoutX="38.0" layoutY="223.0" prefHeight="200.0" prefWidth="200.0" styleClass="interface-photo-zone" />
                <Pane layoutX="38.0" layoutY="158.0" prefHeight="56.0" prefWidth="200.0">
                    <Label layoutX="5.0" layoutY="14.0" text="Déposez votre image ici">
                        <font>
                            <Font size="18.0" />
                        </font>
                    </Label>
                </Pane>
                <Pane layoutX="301.0" layoutY="7.0" prefHeight="312.0" prefWidth="469.0">
                    <Label layoutX="14.0" layoutY="24.0" text="La photo que vous avez déposé se nomme : ">
                        <font>
                            <Font size="16.0" />
                        </font>
                    </Label>
                    <Label fx:id="photoName" layoutX="27.0" layoutY="58.0" text="NAME_PHOTO">
                        <font>
                            <Font size="14.0" />
                        </font>
                    </Label>
                    <Label fx:id="statusScanner" layoutX="54.0" layoutY="289.0" text="STATUS_SCANNER">
                        <font>
                            <Font size="14.0" />
                        </font>
                    </Label>
               <Label layoutX="14.0" layoutY="93.0" text="Voulez vous lancer le scan ?">
                  <font>
                     <Font size="16.0" />
                  </font>
               </Label>
               <Button fx:id="yesScan" layoutX="27.0" layoutY="124.0" mnemonicParsing="false" text="Oui" />
               <Button fx:id="noScan" layoutX="164.0" layoutY="124.0" mnemonicParsing="false" text="Non" />
               <Label layoutX="14.0" layoutY="166.0" text="Voici le produit trouvé :">
                  <font>
                     <Font size="16.0" />
                  </font>
               </Label>
               <Label fx:id="productName" layoutX="203.0" layoutY="170.0" text="NAME_PRODUCT">
                  <font>
                     <Font size="14.0" />
                  </font></Label>
               <Label layoutX="14.0" layoutY="208.0" text="Est-ce le produit voulu ?">
                  <font>
                     <Font size="16.0" />
                  </font>
               </Label>
               <Button fx:id="yesProduct" layoutX="19.0" layoutY="245.0" mnemonicParsing="false" text="Oui" />
               <Button fx:id="noProduct" layoutX="167.0" layoutY="245.0" mnemonicParsing="false" text="Non" />
                </Pane>
                <Pane layoutX="302.0" layoutY="323.0" prefHeight="118.0" prefWidth="469.0">
                    <Label layoutX="14.0" layoutY="14.0" text="Votre type de consommation">
                        <font>
                            <Font size="16.0" />
                        </font>
                    </Label>
                    <ComboBox fx:id="consumptionTypeCombo" layoutX="14.0" layoutY="39.0" prefHeight="25.0" prefWidth="269.0" />
                    <Label layoutX="14.0" layoutY="72.0" text="La quantité consommée :">
                        <font>
                            <Font size="16.0" />
                        </font>
                    </Label>
                    <Spinner fx:id="quantitySpinner" amountToStepBy="1.0" layoutX="202.0" layoutY="72.0" max="9999.9" min="1.0" prefHeight="25.0" prefWidth="81.0" />
                </Pane>
            </Pane>
        </Pane>
    </Pane>

</AnchorPane>
