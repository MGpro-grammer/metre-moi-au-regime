<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="1200.0" prefWidth="2000.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="be.esi.prj.controller.DashboardSearchController">
    <stylesheets>
        <URL value="@../style/dashboard.css" />
    </stylesheets>

    <Pane prefHeight="600.0" prefWidth="1000.0" styleClass="container-dashboard">
        <Pane layoutX="100.0" layoutY="50.0" prefHeight="500.0" prefWidth="800.0" styleClass="interface-dashboard">
            <Pane layoutY="445.0" prefHeight="56.0" prefWidth="800.0" styleClass="interface-dashboard-ariane">
                <Pane fx:id="home" prefHeight="56.0" prefWidth="100.0">
                    <ImageView fitHeight="30.0" fitWidth="30.0" layoutX="35.0" layoutY="13.0">
                        <Image url="@../images/house-white.png" />
                    </ImageView>
                </Pane>
                <Pane fx:id="user" layoutX="100.0" prefHeight="56.0" prefWidth="100.0">
                    <ImageView fitHeight="30.0" fitWidth="30.0" layoutX="35.0" layoutY="13.0">
                        <Image url="@../images/user-white.png" />
                    </ImageView>
                </Pane>
               <Pane fx:id="photo" layoutX="200.0" prefHeight="56.0" prefWidth="100.0">
                  <ImageView fitHeight="30.0" fitWidth="30.0" layoutX="35.0" layoutY="13.0">
                     <Image url="@../images/file-image.png" />
                  </ImageView>
               </Pane>
               <Pane fx:id="search" layoutX="300.0" prefHeight="56.0" prefWidth="100.0">
                  <ImageView fitHeight="30.0" fitWidth="30.0" layoutX="35.0" layoutY="13.0">
                     <Image url="@../images/search.png" />
                  </ImageView>
               </Pane>
                <Pane fx:id="activity" layoutX="400.0" prefHeight="56.0" prefWidth="100.0">
                    <ImageView fitHeight="30.0" fitWidth="30.0" layoutX="35.0" layoutY="13.0">
                        <Image url="@../images/activity.png"/>
                    </ImageView>
                </Pane>
                <Pane fx:id="product" layoutX="500.0" prefHeight="56.0" prefWidth="100.0">
                    <ImageView fitHeight="30.0" fitWidth="30.0" layoutX="35.0" layoutY="13.0">
                        <Image url="@../images/package-search.png"/>
                    </ImageView>
                </Pane>
                <Pane fx:id="info" layoutX="600.0" prefHeight="56.0" prefWidth="100.0">
                    <ImageView fitHeight="30.0" fitWidth="30.0" layoutX="35.0" layoutY="13.0">
                        <Image url="@../images/info.png"/>
                    </ImageView>
                </Pane>
            </Pane>
            <Pane prefHeight="445.0" prefWidth="800.0">
                <ListView fx:id="foodList" layoutX="14.0" layoutY="14.0" prefHeight="418.0" prefWidth="365.0" />
                <Pane layoutX="400.0" layoutY="23.0" prefHeight="184.0" prefWidth="349.0">
                    <Label layoutX="14.0" layoutY="14.0" text="Vous avez séléctionné :">
                        <font>
                            <Font size="20.0"/>
                        </font>
                    </Label>
                    <Label fx:id="foodSelected" layoutX="14.0" layoutY="51.0" text="SELECTED_FOOD_RESEARCH"/>
                    <Label layoutX="14.0" layoutY="84.0" text="Voulez-vous ajouté cet aliment ?">
                        <font>
                            <Font size="20.0"/>
                        </font>
                    </Label>
                    <Button fx:id="yesButton" layoutX="90.0" layoutY="120.0" mnemonicParsing="false" text="Oui"/>
                    <Button fx:id="noButton" layoutX="185.0" layoutY="120.0" mnemonicParsing="false" text="Non"/>
                    <Label fx:id="statusValidation" layoutX="14.0" layoutY="153.0" text="STATUS_OF_VALIDATION"/>
                </Pane>
                <Pane layoutX="400.0" layoutY="207.0" prefHeight="221.0" prefWidth="349.0">
                    <Label layoutX="14.0" layoutY="14.0" text="Rechercher un aliment :">
                        <font>
                            <Font size="20.0" />
                        </font>
                    </Label>
                    <TextField fx:id="foodField" layoutX="14.0" layoutY="44.0" onAction="#handleSearch" prefHeight="25.0" prefWidth="287.0" />
                    <ComboBox fx:id="consumptionTypeCombo" layoutX="14.0" layoutY="104.0" prefHeight="25.0" prefWidth="287.0" />
                    <Label layoutX="14.0" layoutY="69.0" text="Votre type de consommation">
                        <font>
                            <Font size="20.0" />
                        </font>
                    </Label>
                    <Label layoutX="14.0" layoutY="139.0" text="La quantité consommée">
                        <font>
                            <Font size="20.0" />
                        </font>
                    </Label>
                    <Spinner fx:id="quantitySpinner" amountToStepBy="1.0" layoutX="14.0" layoutY="169.0" max="500.0" min="1.0" prefHeight="25.0" prefWidth="74.0" editable="true" />
                </Pane>
            </Pane>
        </Pane>
    </Pane>
</AnchorPane>
